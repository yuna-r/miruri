{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://miruri.dev/schema/manifest-v1.json",
  "title": "Miruri Artifact Manifest v1",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "miruri_version",
    "project_name",
    "target",
    "build_system",
    "assurance",
    "artifacts",
    "build_log",
    "analysis_file",
    "plan_file"
  ],
  "properties": {
    "schema_version": {
      "const": "miruri.manifest.v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "miruri_version": {
      "type": "string",
      "minLength": 1
    },
    "build_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{20}$"
    },
    "build_status": {
      "enum": [
        "dry-run",
        "succeeded",
        "failed"
      ]
    },
    "project_name": {
      "type": "string",
      "minLength": 1
    },
    "project_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "request_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "reused": {
      "type": "boolean"
    },
    "target": {
      "type": "object",
      "required": [
        "id",
        "display_name",
        "os",
        "arch",
        "triple",
        "object_format",
        "cmake_system_name",
        "cmake_processor",
        "default_linker",
        "requires_sysroot",
        "requires_platform_sdk",
        "capabilities"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": "string"
        },
        "os": {
          "type": "string",
          "minLength": 1
        },
        "arch": {
          "type": "string",
          "minLength": 1
        },
        "triple": {
          "type": "string",
          "minLength": 1
        },
        "object_format": {
          "type": "string",
          "minLength": 1
        },
        "cmake_system_name": {
          "type": "string"
        },
        "cmake_processor": {
          "type": "string"
        },
        "default_linker": {
          "type": "string"
        },
        "requires_sysroot": {
          "type": "boolean"
        },
        "requires_platform_sdk": {
          "type": "boolean"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "build_system": {
      "enum": [
        "cmake",
        "meson",
        "autotools",
        "make",
        "unknown"
      ]
    },
    "sysroot": {
      "type": "object",
      "required": [
        "mode",
        "target_id"
      ],
      "properties": {
        "mode": {
          "enum": [
            "explicit",
            "environment",
            "managed",
            "managed-pending"
          ]
        },
        "target_id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "manifest_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "platform": {
          "type": "string"
        },
        "lock_file": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "toolchain": {
      "type": "object",
      "required": [
        "c_compiler",
        "cxx_compiler"
      ],
      "properties": {
        "c_compiler": {
          "type": "string"
        },
        "cxx_compiler": {
          "type": "string"
        },
        "archiver": {
          "type": "string"
        },
        "ranlib": {
          "type": "string"
        },
        "strip": {
          "type": "string"
        },
        "linker": {
          "type": "string"
        },
        "gcc_toolchain": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "assurance": {
      "enum": [
        "generated",
        "linked",
        "packaged",
        "statically-validated",
        "runtime-unvalidated",
        "native-runtime-validated",
        "behavior-validated",
        "performance-validated"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_path",
          "packaged_path",
          "format",
          "architecture",
          "kind",
          "size",
          "sha256",
          "architecture_ok"
        ],
        "properties": {
          "source_path": {
            "type": "string"
          },
          "packaged_path": {
            "type": "string"
          },
          "package_path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "format": {
            "type": "string"
          },
          "architecture": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "architecture_ok": {
            "type": "boolean"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "codex_repairs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "attempt",
          "status",
          "duration_ms"
        ],
        "properties": {
          "attempt": {
            "type": "integer",
            "minimum": 1
          },
          "mode": {
            "enum": [
              "repair",
              "auto",
              "port"
            ]
          },
          "status": {
            "enum": [
              "repaired",
              "ported",
              "blocked",
              "no-change",
              "error"
            ]
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          },
          "thread_id": {
            "type": "string"
          },
          "turn_id": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "changed_files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "remaining_risks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "prompt_file": {
            "type": "string"
          },
          "diagnostics_file": {
            "type": "string"
          },
          "diagnostics_json_file": {
            "type": "string"
          },
          "event_log": {
            "type": "string"
          },
          "stderr_log": {
            "type": "string"
          },
          "final_message_file": {
            "type": "string"
          },
          "result_file": {
            "type": "string"
          },
          "patch_file": {
            "type": "string"
          },
          "discarded_changes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "reason"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "usage": {
            "type": "object",
            "properties": {
              "input_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "cached_input_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "output_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "reasoning_output_tokens": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          "error": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "build_log": {
      "type": "string"
    },
    "analysis_file": {
      "type": "string"
    },
    "plan_file": {
      "type": "string"
    },
    "license_report_file": {
      "type": "string"
    },
    "sbom_file": {
      "type": "string"
    },
    "integrity_file": {
      "type": "string"
    },
    "ported_source_dir": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
